[Unit]
Description=MilizOS - conclusao do rollback (alinha /boot ao sistema restaurado)
ConditionPathExists=|/.milizos-rollback
ConditionKernelCommandLine=|milizos.rollback
After=local-fs.target
RequiresMountsFor=/boot

[Service]
Type=oneshot
ExecStart=/usr/bin/nos checkpoint finalize

[Install]
WantedBy=multi-user.target
