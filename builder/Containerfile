# MilizOS build container (rootless podman)
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install \
      dnf5 dnf5-plugins rpm-build createrepo_c rpmdevtools \
      squashfs-tools erofs-utils xorriso mtools dosfstools \
      grub2-tools grub2-tools-extra grub2-pc-modules grub2-efi-x64-modules \
      librsvg2-tools ImageMagick optipng python3 python3-pip \
      policycoreutils libselinux-utils python3-libselinux \
      google-noto-sans-fonts jetbrains-mono-fonts-all rsms-inter-fonts \
      cpio xz zstd findutils file which tar gzip gettext make \
    && dnf clean all
WORKDIR /work
